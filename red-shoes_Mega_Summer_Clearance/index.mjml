<mjml>
  <mj-head>
    <mj-title>Exclusive Flash Sale - Up To 80% Off</mj-title>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text font-size="14px" color="#444444" line-height="1.5" />
      <mj-section background-color="#ffffff" />
      <mj-button background-color="#1a73e8" color="#ffffff" font-size="14px" border-radius="4px" font-weight="bold" />
    </mj-attributes>
    <mj-style>
      .footer-link { color: #888888; text-decoration: underline; }
      .social-circle { border: 1px solid #dddddd; border-radius: 50%; width: 30px; height: 30px; display: inline-block; text-align: center; line-height: 30px; color: #777777; margin: 0 5px; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f0f2f5">
    <mj-section padding="40px 20px 20px 20px">
      <mj-column>
        <mj-text align="center" font-size="32px" color="#222222" font-weight="bold" padding="0" letter-spacing="-1px">Mega Summer Clearance</mj-text>
        <mj-text align="center" font-size="20px" color="#e53935" padding="10px 0 0 0" font-weight="bold">Final Call: Up To 80% Off Everything!</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column>
        <mj-image src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&h=300&q=80" alt="Nike Air Max Red" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section padding="30px 30px 40px 30px">
      <mj-column>
        <mj-text align="center" font-size="22px" color="#111111" font-weight="bold">Nike Air Max: Performance Red</mj-text>
        <mj-text align="center" font-size="15px">Step into comfort with the ultimate summer sneaker. Limited stock available at this price.</mj-text>
        <mj-text align="center" font-size="24px" color="#1a73e8" font-weight="bold" padding-top="10px">$149 <span style="font-size: 14px; text-decoration: line-through; color: #999999; font-weight: normal;">$249</span></mj-text>
        <mj-button href="#" padding-top="20px" inner-padding="12px 30px">GRAB THE DEAL</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 10px" background-color="#fafafa">
      <mj-column width="100%">
        <mj-text align="center" font-size="22px" color="#333333" font-weight="bold" padding-bottom="20px">Trending Collections</mj-text>
      </mj-column>
      
      <mj-column width="33.33%">
        <mj-image src="https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=180&h=120&q=80" alt="Air Jordan" width="160px" border-radius="8px" />
        <mj-text align="center" font-size="15px" font-weight="bold">Air Jordan High</mj-text>
        <mj-text align="center" font-size="12px" height="40px">The icon that started it all. Always in style.</mj-text>
        <mj-text align="center" font-size="16px" color="#1a73e8" font-weight="bold">$185</mj-text>
        <mj-button href="#" font-size="12px" padding-bottom="20px">Shop Now</mj-button>
      </mj-column>

      <mj-column width="33.33%">
        <mj-image src="https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=180&h=120&q=80" alt="Air Jordan" width="160px" border-radius="8px" />
        <mj-text align="center" font-size="15px" font-weight="bold">Retro Edition</mj-text>
        <mj-text align="center" font-size="12px" height="40px">Classic design meets modern cushioning.</mj-text>
        <mj-text align="center" font-size="16px" color="#1a73e8" font-weight="bold">$170</mj-text>
        <mj-button href="#" font-size="12px" padding-bottom="20px">Shop Now</mj-button>
      </mj-column>

      <mj-column width="33.33%">
        <mj-image src="https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=180&h=120&q=80" alt="Air Jordan" width="160px" border-radius="8px" />
        <mj-text align="center" font-size="15px" font-weight="bold">Urban Street</mj-text>
        <mj-text align="center" font-size="12px" height="40px">Perfect for your everyday city adventures.</mj-text>
        <mj-text align="center" font-size="16px" color="#1a73e8" font-weight="bold">$155</mj-text>
        <mj-button href="#" font-size="12px" padding-bottom="20px">Shop Now</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="transparent" padding="40px 20px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#777777">
          <p>You're receiving this because you're a valued member of our community.</p>
          <p>123 Fashion Ave, New York, NY 10001</p>
          <p><a href="#" class="footer-link">Manage Preferences</a> | <a href="#" class="footer-link">Unsubscribe</a></p>
        </mj-text>
            
        
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>