    </mj-text>
    <mj-button href="#"color="#ffffff"background-color="transparent" font-size="16px" padding="10px 25px" border-radius="5px" border="1px double #f4f5f5" align="left">See the collection &rarr;</mj-button>
    </mj-column>
    </mj-section>
    
    <mj-section background-color="#000000" padding="0px 0px">
