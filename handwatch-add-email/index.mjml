<mjml>
  <mj-head>
    <mj-title>email title</mj-title>
    <mj-preview>email preview</mj-preview>
    <mj-attributes>
        <mj-all font-family="Arial, sans-serif" />

        <mj-class name="primary-text"color="#ffffff"/>
        <mj-class name="secondary-text"color="#003051" align="center"font-size="14px" font-weight="bold"/>
        
        <mj-class name="dis-text"align="center" font-size="12px" color="#1b1a1a" line-height="1.5"/>
        
        <mj-class name="price-text"align="center" font-size="16px" font-weight="bold" color="#000000"/>
        
        <mj-class name="button-bg" background-color="transparent" border="1px solid #003051"color="#003051"/>

        <mj-class name="footer-text"color="#ffffff" align="center"/>
        
        <mj-section padding="0" />
    
    </mj-attributes>

  </mj-head>
  <mj-body>
  
  <mj-raw>
      <!-- Image Header -->
    </mj-raw>

  <mj-section>
  <mj-column width="600px">
  <mj-text mj-class="secondary-text" font-weight="bold" align="center">
    Free shipping on orders over $50&rarr;
  </mj-text>
    </mj-column>    
    </mj-section>
    <mj-section background-url="https://media.istockphoto.com/id/890289344/photo/the-perfect-outfit-means-a-perfect-day.webp?a=1&b=1&s=612x612&w=0&k=20&c=lXVxkET-3Yjmo2t_4Vripyub-2H0Y6TsK9QfSiDf7uk=" background-size="cover" background-position="center"padding="40px 20px">
